# Copy this file to .env and adjust the values (.env is never committed to Git)
PORT=3000
DATABASE_PATH=./data/convocadas.db

# AI squad suggestions (US-06) with the Google Gemini API free tier.
# Get a free key at https://aistudio.google.com/apikey (no card needed). Leave it empty to disable the feature.
GEMINI_API_KEY=
# Model ID as shown in Google AI Studio
GEMINI_MODEL=gemini-flash-lite-latest
